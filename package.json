{
  "name": "helper",
  "version": "1.0.0",
  "description": "A lightweight desktop helper",
  "main": "out/main/index.js",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": "11.11.x"
  },
  "scripts": {
    "predev": "node scripts/build-macos-hotkey.mjs",
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prebuild": "node scripts/build-macos-hotkey.mjs",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && node scripts/package.mjs",
    "package:installer": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "openai": "6.38.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@electron/packager": "20.0.0",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "10.5.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.7",
    "electron-vite": "5.0.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "postcss": "8.5.23",
    "prettier": "3.9.4",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.helper.app",
    "productName": "Helper",
    "copyright": "Copyright © 2024 Helper",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "!out/**/*.map"
    ],
    "extraMetadata": {
      "main": "out/main/index.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "signtoolOptions": {
        "signingHashAlgorithms": null,
        "sign": null
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Helper"
    },
    "mac": {
      "minimumSystemVersion": "14.0",
      "extraFiles": [
        {
          "from": ".native-build/helper-fn-modifier-hotkeys",
          "to": "Helpers/helper-fn-modifier-hotkeys"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "用于将语音转写为面试问题文本。"
      }
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
